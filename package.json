{
  "name": "new-tab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:ff": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:ff": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:ff": "wxt zip -b firefox --mv3",
    "watch:ff": "nodemon --watch src -e js,ts,vue,css,html --exec \"npm run build:ff\"",
    "android": "web-ext run -t firefox-android -s .output/firefox-mv3 --firefox-apk org.mozilla.firefox_beta --adb-device",
    "clean": "rm -rf .output",
    "tsc": "vue-tsc --noEmit",
    "prettier:check": "npx prettier --check .",
    "prettier:write": "npx prettier --write .",
    "lint": "npx eslint src",
    "lint:web-ext": "npm run build:ff && npm run web-ext",
    "web-ext": "npx web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "package": "npm run tsc && npm run zip && npm run zip:ff",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@uppy/core": "^5.2.0",
    "@uppy/drop-target": "^4.1.0",
    "bootstrap": "^5.3.8",
    "camelcase": "^9.0.0",
    "idb": "^8.0.3",
    "octokit": "^5.0.5",
    "simple-icons": "^16.28.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@types/bootstrap": "^5.2.11",
    "@types/chrome": "^0.2.6",
    "@types/firefox-webext-browser": "^143.0.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/i18n": "^0.2.7",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vue-tsc": "^3.3.10",
    "web-ext": "^10.6.0",
    "wxt": "0.21.4"
  }
}
